# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# Set to "false" in production.
FLASK_DEBUG=true

# Port for local development server.
PORT=5000

# Which media processor implementation to use.
# "mock" (default) simulates processing for local UI development.
# "ffmpeg_local" runs real FFmpeg processing (requires FFmpeg installed,
# and should only be used in a persistent worker process, not Vercel).
MEDIA_PROCESSOR_PROVIDER=mock

# Placeholder for a future authorized metadata/media API key, if your
# authorized media source requires authentication.
API_KEY=

# Base URL of a separate, long-running authorized media-processing worker
# (used once you move real processing off of Vercel's serverless functions).
MEDIA_PROCESSOR_URL=

# Shared secret used to authenticate requests to MEDIA_PROCESSOR_URL.
MEDIA_PROCESSOR_TOKEN=
